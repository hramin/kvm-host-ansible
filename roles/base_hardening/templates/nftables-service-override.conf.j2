# {{ ansible_managed }}
# Debian's nftables.service runs "nft flush ruleset" on stop (and therefore on
# restart), which would also wipe libvirt's tables. Stop removes
# only this role's table instead; start/reload load /etc/nftables.conf, which
# replaces only that table too.
[Service]
ExecStop=
ExecStop=-/usr/sbin/nft delete table inet {{ base_hardening_firewall_table }}
