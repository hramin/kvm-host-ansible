## {{ ansible_managed }}
## Hypervisor-focused audit rules: who changed access, the firewall, libvirt
## or kernel settings on this host. Search with: ausearch -k <key>

## Accounts and privileges
-w /etc/passwd -p wa -k identity
-w /etc/group -p wa -k identity
-w /etc/shadow -p wa -k identity
-w /etc/gshadow -p wa -k identity
-w /etc/sudoers -p wa -k privilege
-w /etc/sudoers.d -p wa -k privilege
-a always,exit -F arch=b64 -S execve -C uid!=euid -F euid=0 -F auid>=1000 -F auid!=-1 -k privilege

## Remote access and firewall
-w /etc/ssh/sshd_config -p wa -k sshd
-w /etc/ssh/sshd_config.d -p wa -k sshd
-w /etc/nftables.conf -p wa -k firewall

## Hypervisor configuration and tools
-w /etc/libvirt -p wa -k libvirt
-w /etc/default/libvirtd -p wa -k libvirt
-w /etc/default/libvirt-guests -p wa -k libvirt
-w /usr/bin/virsh -p x -k libvirt-tools
-w /usr/bin/qemu-img -p x -k libvirt-tools

## Kernel parameters and modules
-w /etc/sysctl.conf -p wa -k sysctl
-w /etc/sysctl.d -p wa -k sysctl
-w /etc/modprobe.d -p wa -k modules
-w /etc/modules-load.d -p wa -k modules
-a always,exit -F arch=b64 -S init_module,finit_module,delete_module -k modules

## Time
-a always,exit -F arch=b64 -S adjtimex,settimeofday,clock_settime -k time-change
-w /etc/localtime -p wa -k time-change
