# {{ ansible_managed }}
# Drop-in for /etc/systemd/journald.conf (Debian 13 no longer ships that file in /etc).

[Journal]
Storage=persistent
# Debian 12/13 do not install rsyslog by default; only forward when one is present.
ForwardToSyslog={{ base_hardening_journald_forward_to_syslog | bool | ternary('yes', 'no') }}
Compress=yes
SystemMaxUse={{ base_hardening_journald_system_max_use }}
SystemKeepFree={{ base_hardening_journald_system_keep_free }}
SystemMaxFileSize={{ base_hardening_journald_system_max_file_size }}
MaxRetentionSec={{ base_hardening_journald_max_retention }}
