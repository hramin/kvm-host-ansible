# {{ ansible_managed }}
# Per-guest QEMU logs. virtlogd already rotates them at 2 MiB (max_size
# 2097152, 3 backups). The threshold here is one byte above that, so this
# rule only acts if virtlogd is switched off and QEMU writes the file itself.
/var/log/libvirt/qemu/*.log {
        size 2097153
        rotate 8
        missingok
        notifempty
        compress
        delaycompress
        copytruncate
}
