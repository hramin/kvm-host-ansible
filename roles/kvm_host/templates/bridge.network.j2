# {{ ansible_managed }}
[Match]
Name={{ kvm_host_bridge_name }}

[Link]
{% if kvm_host_bridge_ip_mode == 'none' %}
# L2-only bridge: no host address, so it must not hold up network-online.target.
RequiredForOnline=no
{% endif %}

[Network]
ConfigureWithoutCarrier=yes
{% if kvm_host_bridge_ip_mode == 'dhcp' %}
DHCP=ipv4
{% elif kvm_host_bridge_ip_mode == 'static' %}
Address={{ kvm_host_bridge_address }}
{%   if kvm_host_bridge_gateway | length > 0 %}
Gateway={{ kvm_host_bridge_gateway }}
{%   endif %}
{%   for server in kvm_host_bridge_dns %}
DNS={{ server }}
{%   endfor %}
{% else %}
LinkLocalAddressing=no
IPv6AcceptRA=no
{% endif %}
