---
# Template: envsubst < all.yml.in > all.yml (WORK = directory used by build-disk.sh)
# Fresh Debian 13 server booted under QEMU TCG (no KVM).
ansible_user: debian
ansible_ssh_private_key_file: "${WORK}/keys/{{ 'admin' if ansible_user == 'kvmadmin' else 'bootstrap' }}"
ansible_ssh_common_args: "-o UserKnownHostsFile=${WORK}/known_hosts -o StrictHostKeyChecking=accept-new"
base_hardening_debian_version: "13"
# QEMU user networking via docker-proxy: the guest sees the controller as 172.17.0.1.
base_hardening_management_cidrs: [172.17.0.0/16]
base_hardening_admin_users:
  - name: kvmadmin
    ssh_keys:
      - "${ADMIN_PUBKEY}"
# TCG: no vmx/svm and no /dev/kvm inside the VM.
kvm_host_allow_software_emulation: true
# Same as the lab inventory: single NIC, NAT network for guests.
kvm_host_libvirt_default_network_enabled: true
